{
  "contribution": {
    "agent": "Claude (Cowork)",
    "model": "Claude Opus 5 (claude-opus-5)",
    "start": "2026-08-03 05:47 UTC",
    "end": "2026-08-03 05:47 UTC",
    "procedure": "Director contribution-tagging procedure (docs/decisions/0006)."
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-uppercut.local/schemas/animation_model.schema.json",
  "title": "Animation Model",
  "description": "ROADMAP Phase 1A step 4: animation states. Animation supplies POSE; it never supplies TRUTH. Engine-neutral (Rule 22 / Decision 0002). Definitions only; no engine implementation is claimed (Rule 18).",
  "type": "object",
  "required": ["schema_version", "tuning_status", "authority", "state_animations", "move_animations", "interrupts", "blending", "damage_visualization", "stance", "prohibitions", "invariants"],
  "additionalProperties": false,
  "properties": {
    "contribution": { "type": "object" },
    "$comment": { "type": "string" },
    "schema_version": { "type": "string" },
    "tuning_status": { "enum": ["hypothesis", "validated"] },
    "authority": {
      "type": "object",
      "required": ["writes_simulation_state", "participates_in_determinism_hash", "derivation", "hitbox_transform_source", "root_motion_drives_position"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "writes_simulation_state": { "const": false },
        "participates_in_determinism_hash": { "const": false },
        "derivation": { "const": "pure_function_of_authoritative_state_and_tick" },
        "hitbox_transform_source": {
          "const": "authored_pose_sampled_at_tick_index",
          "description": "Rule 13 / criterion E.19: hitbox transforms are sampled from authored pose at a fixed tick index, NOT from blended runtime playback. Blending is a presentation concern; sampling it into collision would make contact depend on frame timing."
        },
        "root_motion_drives_position": {
          "const": false,
          "description": "Rule 13: feet establish position via the movement model. Root motion driving position would let animation overrule the authoritative locomotion contract."
        }
      }
    },
    "state_animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["combat_state", "clip_id", "loops"],
        "additionalProperties": false,
        "properties": {
          "combat_state": { "type": "string", "description": "A fighter_action state id from data/combat_states.json." },
          "clip_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "loops": { "type": "boolean" },
          "duration_source": { "enum": ["move_data", "condition_scaled", "authoritative_clock", "sustained", "authored_ticks"] },
          "notes": { "type": "string" }
        }
      }
    },
    "move_animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["move_id", "clip_id", "startup_ticks", "active_ticks", "recovery_ticks"],
        "additionalProperties": false,
        "properties": {
          "move_id": { "type": "string" },
          "clip_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "startup_ticks": { "type": "integer", "minimum": 0 },
          "active_ticks": { "type": "integer", "minimum": 0 },
          "recovery_ticks": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "interrupts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "interrupts_everything_below", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "priority": { "type": "integer", "minimum": 0 },
          "interrupts_everything_below": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blending": {
      "type": "object",
      "required": ["max_blend_ticks", "blend_may_delay_state_change", "input_to_visible_response_ticks"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "max_blend_ticks": { "type": "integer", "minimum": 0 },
        "blend_may_delay_state_change": {
          "const": false,
          "description": "Rules 13 and 19: no artificial transition delay. The authoritative state changes on its tick; the blend catches up visually."
        },
        "input_to_visible_response_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "Rule 19 places 'impressively responsive' first in the game-feel order. Visible response must begin within this many ticks of the authoritative state change."
        }
      }
    },
    "damage_visualization": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition_region", "visible", "side_specific"],
        "additionalProperties": false,
        "properties": {
          "condition_region": { "type": "string" },
          "visible": { "const": true, "description": "Rule 14: accumulated condition the simulation treats as decisive must be visually attributable." },
          "side_specific": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "stance": {
      "type": "object",
      "required": ["southpaw_handling", "switch_mechanism"],
      "additionalProperties": false,
      "properties": {
        "southpaw_handling": { "const": "exact_mirror", "description": "Rule 15 and the movement model's stance_mirroring const: southpaw is the exact reflection, never a separate clip set with different timing." },
        "switch_mechanism": { "type": "string", "minLength": 1 }
      }
    },
    "prohibitions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "rule": { "type": "string" },
          "statement": { "type": "string", "minLength": 1 },
          "enforced_by": { "type": "string" }
        }
      }
    }
  }
}
