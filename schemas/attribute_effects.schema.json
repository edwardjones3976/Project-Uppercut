{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-uppercut.local/schemas/attribute_effects.schema.json",
  "title": "Attribute effects",
  "description": "How fighter attributes reach the fight. One bounded multiplier band per effect, interpolated linearly across the -100..+100 attribute range.",
  "type": "object",
  "required": ["schema_version", "tuning_status", "curve", "bounds", "effects", "prohibitions", "invariants"],
  "additionalProperties": false,
  "properties": {
    "contribution": { "type": "object" },
    "$comment": { "type": "string" },
    "schema_version": { "type": "string" },
    "tuning_status": { "const": "hypothesis" },
    "curve": {
      "type": "object",
      "required": ["shape", "domain", "centre_multiplier"],
      "additionalProperties": false,
      "properties": {
        "shape": { "const": "linear" },
        "domain": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "centre_multiplier": {
          "const": 1.0,
          "description": "Rule 10: a zeroed attribute must multiply by exactly one, so an empty card fights the baseline model."
        },
        "notes": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["min_multiplier", "max_multiplier", "max_band_width", "min_band_width"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "min_multiplier": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "max_multiplier": { "type": "number", "exclusiveMinimum": 1 },
        "max_band_width": { "type": "number", "exclusiveMinimum": 0 },
        "min_band_width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attribute", "scales", "multiplier_at_minus_100", "multiplier_at_plus_100", "direction", "rule"],
        "additionalProperties": false,
        "properties": {
          "attribute": { "type": "string" },
          "scales": { "type": "string" },
          "multiplier_at_minus_100": { "type": "number", "exclusiveMinimum": 0 },
          "multiplier_at_plus_100": { "type": "number", "exclusiveMinimum": 0 },
          "direction": { "enum": ["higher_is_stronger", "higher_is_weaker"] },
          "rule": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "unexpressed_attributes": {
      "type": "object",
      "required": ["reason", "not_yet_expressed"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "reason": { "type": "string", "minLength": 40 },
        "not_yet_expressed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "reference_model_coverage": {
      "type": "object",
      "required": ["reason", "not_yet_expressed"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "reason": { "type": "string", "minLength": 40 },
        "not_yet_expressed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "prohibitions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "statement", "enforced_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "rule": { "type": "string" },
          "statement": { "type": "string" },
          "enforced_by": { "type": "string" }
        }
      }
    }
  }
}
